# Environment Variables for ComplaintIQ

# Database configuration
# Default uses local SQLite for instant setup. For PostgreSQL: postgresql://user:password@localhost:5432/complaintiq
DATABASE_URL=sqlite:///./complaintiq.db

# Storage configuration
MODELS_STORAGE_DIR=./models_storage
DATA_DIR=../data
UPLOAD_MAX_SIZE_MB=50

# Application configuration
APP_NAME=ComplaintIQ
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Analytical Defaults
DEFAULT_SIMILARITY_THRESHOLD=0.65
DEFAULT_EMERGING_GROWTH_THRESHOLD=0.5
DEFAULT_PRIORITY_VOLUME_WEIGHT=0.4
DEFAULT_PRIORITY_SEVERITY_WEIGHT=0.3
DEFAULT_PRIORITY_GROWTH_WEIGHT=0.3
